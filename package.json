{
  "name": "margin-pdf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "proof": "node --import tsx scripts/proof.ts",
    "release:fixtures": "node --import tsx scripts/release/generate.ts",
    "release:pdfkit": "node --import tsx scripts/release/pdfkit.ts",
    "release:licenses": "node --import tsx scripts/release/licenses.ts",
    "release:browser-output": "node --import tsx scripts/release/verify-browser.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "mupdf": "1.28.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js-core": "6.1.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
